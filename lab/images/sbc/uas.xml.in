<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!--
  Laboratorio STFC: OpenSIPS/FreeSWITCH simulados atendendo como a caixa postal.
  INVITE -> 100 -> 180 -> 200 (SDP PCMA) -> ACK -> espera o BYE da VM de teste.
  Sem BYE em @VM_MAX_MS@ ms (tempo maximo da gravacao), o "FS" desliga.
-->
<scenario name="STFC lab - caixa postal simulada">

  <recv request="INVITE" crlf="true" rrs="true">
    <action>
      <ereg regexp=".*" search_in="hdr" header="From:" check_it="true" assign_to="cf"/>
    </action>
  </recv>

  <send>
    <![CDATA[

      SIP/2.0 100 Trying
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <send>
    <![CDATA[

      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]LAB[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:lab@[local_ip]:[local_port]>
      Content-Length: 0

    ]]>
  </send>

  <pause milliseconds="300"/>

  <send retrans="500">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]LAB[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:lab@[local_ip]:[local_port]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=lab 1 1 IN IP[local_ip_type] [local_ip]
      s=stfc-lab
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 8
      a=rtpmap:8 PCMA/8000

    ]]>
  </send>

  <recv request="ACK" crlf="true"/>

  <recv request="BYE" timeout="@VM_MAX_MS@" ontimeout="fs_bye"/>

  <send next="fim">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <label id="fs_bye"/>

  <send retrans="500">
    <![CDATA[

      BYE [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: <sip:lab@[local_ip]>;tag=[pid]LAB[call_number]
      To: [$cf]
      Call-ID: [call_id]
      CSeq: 2 BYE
      Max-Forwards: 70
      Content-Length: 0

    ]]>
  </send>

  <recv response="200"/>

  <label id="fim"/>

  <timewait milliseconds="2000"/>

</scenario>
