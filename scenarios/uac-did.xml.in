<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!--
  WEB-1437 - INVITE para DID via OpenSIPS (operadora) -> load_balancer -> FreeSWITCH.
  Destino esperado: DID DIRECT-IP (call_type 2) que o FS entrega ao atendedor SIPp
  desta VM (scenarios/uas-answer.xml.in, UAS_PORT). Sem atendedor, o DID precisa ser
  atendido no proprio FS (ex.: caixa postal).

  Modelo processado pelo flux-loadtest.sh. Nao usar direto no sipp:
    @HOLD_MS@     tempo da chamada atendida antes do BYE (ms)
    @MEDIA_PORT@  [rtpstream_audio_port] (midia rtp) ou [media_port] (midia none)
    @RTP_ACTION@  inicia o rtp_stream (midia rtp) ou vazio
    @RUN_ID@      identificador da execucao (header X-Flux-Loadtest)

  CSV (-inf): [field0]=DID discado  [field1]=numero de A
  Origem autorizada por IP: o IP da VM precisa estar no grupo de operadoras do
  OpenSIPS (address, FLUX_GRP_CARRIERS). Nao ha digest neste caminho.

  RTD 1 = INVITE -> 100 (resposta do OpenSIPS)
  RTD 2 = INVITE -> 200 (roteamento OpenSIPS + dialplan Lua + MySQL + answer)
  Respostas de erro ao INVITE sao tratadas pelo comportamento padrao do SIPp
  (ACK automatico, chamada contada como falha, linha no error_file).
-->
<scenario name="WEB-1437 INVITE DID">

  <send retrans="500">
    <![CDATA[

      INVITE sip:[field0]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch];rport
      Max-Forwards: 70
      From: <sip:[field1]@[local_ip]>;tag=[pid]LT[call_number]
      To: <sip:[field0]@[remote_ip]:[remote_port]>
      Call-ID: [call_id]
      CSeq: 1 INVITE
      Contact: <sip:[field1]@[local_ip]:[local_port]>
      Allow: INVITE, ACK, BYE, CANCEL, OPTIONS
      User-Agent: flux-loadtest
      X-Flux-Loadtest: @RUN_ID@
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=loadtest 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=flux-loadtest
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio @MEDIA_PORT@ RTP/AVP 8 101
      a=rtpmap:8 PCMA/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-15
      a=ptime:20
      a=sendrecv

    ]]>
  </send>

  <recv response="100" optional="true" rtd="1"/>
  <recv response="180" optional="true"/>
  <recv response="183" optional="true"/>
  <recv response="200" rrs="true" rtd="2"/>

  <send>
    <![CDATA[

      ACK [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch];rport
      [routes]
      Max-Forwards: 70
      From: <sip:[field1]@[local_ip]>;tag=[pid]LT[call_number]
      To: <sip:[field0]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 1 ACK
      Contact: <sip:[field1]@[local_ip]:[local_port]>
      Content-Length: 0

    ]]>
  </send>

  @RTP_ACTION@

  <!-- Espera o hold; se o FS encerrar antes (queda do outro lado), responde o BYE. -->
  <recv request="BYE" timeout="@HOLD_MS@" ontimeout="local_bye"/>

  <nop>
    <action>
      <log message="REMOTE_BYE [call_id]"/>
    </action>
  </nop>

  <send next="fim">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[field1]@[local_ip]:[local_port]>
      Content-Length: 0

    ]]>
  </send>

  <label id="local_bye"/>

  <nop>
    <action>
      <log message="LOCAL_BYE [call_id]"/>
    </action>
  </nop>

  <send retrans="500">
    <![CDATA[

      BYE [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch];rport
      [routes]
      Max-Forwards: 70
      From: <sip:[field1]@[local_ip]>;tag=[pid]LT[call_number]
      To: <sip:[field0]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 2 BYE
      Contact: <sip:[field1]@[local_ip]:[local_port]>
      Content-Length: 0

    ]]>
  </send>

  <recv response="481" optional="true" next="fim"/>
  <recv response="200" crlf="true"/>

  <label id="fim"/>

  <timewait milliseconds="2000"/>

  <ResponseTimeRepartition value="10, 20, 50, 100, 200, 500, 1000, 2000"/>
  <CallLengthRepartition value="1000, 5000, 10000, 30000, 60000, 120000"/>

</scenario>
